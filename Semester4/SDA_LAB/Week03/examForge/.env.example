# ExamForge - Environment Variables
# Copy this file to ".env" and fill in your own values. Never commit ".env".

# Local SQLite database (for saved tests)
# On Windows, use a relative path like: file:./db/custom.db
DATABASE_URL=

# Supabase (question bank, read-only via anon key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
